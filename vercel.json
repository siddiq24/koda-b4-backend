{
    "version": 2,
    "builds": [
        {
            "src": "main.go",
            "use": "@vercel/go"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/api/index.go"
        }
    ],
    "env": {
        "GO111MODULE": "on",
        "ENVIRONMENT": "production"
    }
}