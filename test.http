###############################################
###           ERROR TESTING CASES           ###
###############################################

### Test - Invalid Product ID
GET {{BASE_URL}}/admin/products/abc
Authorization: {{token}}

### Test - Missing Required Fields (Create Product)
POST {{BASE_URL}}/admin/products
Authorization: {{token}}
Content-Type: application/json

{
  "title": "Incomplete Product"
}

### Test - Invalid JSON
POST {{BASE_URL}}/admin/products
Authorization: {{token}}
Content-Type: application/json

{
  "title": "Invalid JSON",
  "base_price": "not a number"
}

### Test - Unauthorized Access (without token)
GET {{BASE_URL}}/admin/products

### Test - Invalid Token
GET {{BASE_URL}}/admin/products
Authorization: Bearer invalid_token_12345

