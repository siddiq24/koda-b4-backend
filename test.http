###############################################
###          TRANSACTIONS ENDPOINTS         ###
###############################################

### Get All Transactions (with pagination)
GET {{BASE_URL}}/admin/transactions?page=1
Authorization: {{token}}

### Get All Transactions (with status filter)
GET {{BASE_URL}}/admin/transactions?page=1&status=pending
Authorization: {{token}}

### Get All Transactions (without filters)
GET {{BASE_URL}}/admin/transactions
Authorization: {{token}}

### Create Transaction
POST {{BASE_URL}}/admin/transactions
Authorization: {{token}}
Content-Type: application/json

{
  "user_id": 5,
  "shipping_id": 1,
  "total_order": 150000,
  "status_id": 1,
  "promo_id": null,
  "products": [
    {
      "product_id": 1,
      "size_id": 2,
      "varian_id": null,
      "qty": 2
    },
    {
      "product_id": 3,
      "size_id": 1,
      "varian_id": 1,
      "qty": 1
    }
  ]
}

### Update Transaction Status
PATCH {{BASE_URL}}/admin/transactions/13
Authorization: {{token}}
Content-Type: application/json

{
  "status_id": 2
}

### Delete Transaction
DELETE {{BASE_URL}}/admin/transactions/1
Authorization: {{token}}

