###############################################
###            PRODUCTS ENDPOINTS           ###
###############################################

### Get All Products (with pagination and search)
GET {{BASE_URL}}/admin/products?page=1&search=coffee
Authorization: {{token}}

### Get All Products (without filters)
GET {{BASE_URL}}/admin/products
Authorization: {{token}}

### Create Product
POST {{BASE_URL}}/admin/products
Authorization: {{token}}
Content-Type: application/json

{
  "title": "Espresso Premium",
  "description": "Rich and bold espresso coffee",
  "base_price": 35000,
  "stock": 100,
  "category_id": 1,
  "images": [
    {
      "img": "espresso-1.jpg"
    },
    {
      "img": "espresso-2.jpg"
    }
  ],
  "sizes": [1, 2, 3]
}

### Update Product
PATCH {{BASE_URL}}/admin/products/51
Authorization: {{token}}
Content-Type: application/json

{
  "title": "Espresso Premium Updated",
  "description": "Updated description",
  "base_price": 40000,
  "stock": 150,
  "category_id": 1
}

### Update Product (partial update)
PATCH {{BASE_URL}}/admin/products/51
Authorization: {{token}}
Content-Type: application/json

{
  "stock": 200
}

### Delete Product (soft delete)
DELETE {{BASE_URL}}/admin/products/51
Authorization: {{token}}

###############################################
###           CATEGORIES ENDPOINTS          ###
