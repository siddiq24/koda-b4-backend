### Create order
POST {{BASE_URL}}/order
Authorization: {{BASE_URL}}
Content-Type: application/json

{
  "shipping_id": 1,
  "payment_method_id": 2,
  "no_order": "ORD-20251110-006",
  "status_id": 1,
  "promo_id": 1,
  "products": [
    {
      "id": 10,
      "size_id": 2,
      "variant_id": 1,
      "qty": 2,
      "total": 50000
    },
    {
      "id": 11,
      "size_id": 1,
      "variant_id": 2,
      "qty": 1,
      "total": 25000
    }
  ]
}

