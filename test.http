###############################################
###        ADVANCED QUERY EXAMPLES          ###
###############################################

### Search Products with Specific Term
GET {{BASE_URL}}/admin/products?page=1&search=latte
Authorization: {{token}}

### Get Second Page of Products
GET {{BASE_URL}}/admin/products?page=2
Authorization: {{token}}

### Filter Transactions by Status "completed"
GET {{BASE_URL}}/admin/transactions?status=completed
Authorization: {{token}}

### Search Users by Email Domain
GET {{BASE_URL}}/admin/users?search=@gmail.com
Authorization: {{token}}

###############################################
###           COMPLEX WORKFLOWS             ###
###############################################

### Workflow 1: Create Complete Product
# Step 1: Create Product
POST {{BASE_URL}}/admin/products
Authorization: {{token}}
Content-Type: application/json

{
  "title": "Cappuccino Special",
  "description": "Creamy cappuccino with foam art",
  "base_price": 42000,
  "stock": 75,
  "category_id": 1,
  "images": [
    {
      "img": "cappuccino-main.jpg"
    }
  ],
  "sizes": [1, 2]
}

###

# Step 2: Add More Images (assuming product_id = 10)
POST {{BASE_URL}}/admin/products/10/images
Authorization: {{token}}
Content-Type: application/json

{
  "image": "cappuccino-side.jpg"
}

###

# Step 3: Verify Product Created
GET {{BASE_URL}}/admin/products?search=cappuccino
Authorization: {{token}}

###

### Workflow 2: Process Order
# Step 1: Create Transaction
POST {{BASE_URL}}/admin/transactions
Authorization: {{token}}
Content-Type: application/json

{
  "user_id": 3,
  "shipping_id": 2,
  "total_order": 85000,
  "status_id": 1,
  "products": [
    {
      "product_id": 10,
      "size_id": 2,
      "qty": 2
    }
  ]
}

###

# Step 2: Update Status to Processing (assuming order_id = 15)
PATCH {{BASE_URL}}/admin/transactions/15
Authorization: {{token}}
Content-Type: application/json

{
  "status_id": 2
}

###

# Step 3: Update Status to Completed
PATCH {{BASE_URL}}/admin/transactions/15
Authorization: {{token}}
Content-Type: application/json

{
  "status_id": 3
}



