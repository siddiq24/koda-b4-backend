  "password": "password123",
  "role": "user"
}

### Create Admin User
POST {{BASE_URL}}/admin/users
Authorization: {{token}}
Content-Type: application/json

{
  "email": "newadmin@example.com",
  "password": "admin123456",
  "role": "admin"
}

### Update User
PATCH {{BASE_URL}}/admin/users/5
Authorization: {{token}}
Content-Type: application/json

{
  "email": "updated@example.com",
  "role": "admin"
}

